generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum InvoiceStatus {
  PAID
  UNPAID
}

enum ChasingProfile {
  STRICT
  NORMAL
  RELAXED
}

enum ContactChannel {
  EMAIL
  SMS
  EMAIL_AND_SMS
  // Legacy values — kept for backward compatibility, disabled in UI
  WHATSAPP
  BOTH
  ALL
}

enum ReminderTone {
  FRIENDLY
  PROFESSIONAL
  FIRM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SubscriptionTier {
  FREE
  PRO
}

enum InvoiceState {
  DRAFT               // Still being edited
  APPROVAL_REQUIRED   // Needs a second set of eyes before sending
  PENDING             // Sent to client, awaiting due date
  DUE_SOON            // Pre-due warning stage
  DUE                 // Due today
  GRACE_PERIOD        // Past due, silent monitoring
  OVERDUE_L1          // Polite nudge
  OVERDUE_L2          // Firm nudge
  OVERDUE_L3          // Serious escalation
  FINAL_NOTICE        // Last automated attempt
  RECURRING_CHASE     // Infinite loop (if enabled)
  UNVERIFIED_PAYMENT  // Client claimed payment (Reminders paused)
  ESCROW_HELD         // Funds are in escrow
  PARTIALLY_PAID      // Payment received, balance remains
  OVERPAID            // Client paid too much, needs credit/refund
  PAID                // Success
  REFUNDED            // Money returned to client
  DISPUTED            // Client flagged a problem
  LEGAL_HOLD          // Paused for legal/contractual review
  DEBT_COLLECTION     // Handled by external agency
  VOIDED              // Canceled/Invalid
  WRITTEN_OFF         // Bad debt, for accounting
  MANUAL_REVIEW       // System error (bounce/API failure)
}

// ─── User ────────────────────────────────────────────────

model User {
  id                String    @id @db.Uuid
  email             String    @unique
  name              String?
  
  // Reminder preferences
  defaultTone       ReminderTone @default(PROFESSIONAL)
  customIntervals   Json?     // User-defined reminder intervals: { stage2Days: 3, stage3Days: 7, stage4Days: 14 }
  chaseUntilPaid    Boolean   @default(false)  // Global default for new invoices
  chaseIntervalDays Int       @default(7)      // Default recurring chase interval
  isAdmin           Boolean   @default(false)
  shieldMode        Boolean   @default(false)

  // Subscription & Billing
  subscriptionTier           SubscriptionTier @default(FREE)
  lemonSqueezyCustomerId     String?          @unique
  lemonSqueezySubscriptionId String?          @unique
  subscriptionStatus         String?
  subscriptionPeriodEnd      DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  invoices          Invoice[]
  clients           Client[]
  credentials       UserCredential[]
}

// ─── Client ──────────────────────────────────────────────

model Client {
  id             String         @id @default(cuid())
  userId         String         @db.Uuid
  name           String
  email          String
  whatsappNumber String?        // Kept for data compatibility
  smsNumber      String?
  chasingProfile ChasingProfile @default(NORMAL)
  contactChannel ContactChannel @default(EMAIL)

  // Behavioral Tracking & Overrides
  behaviorScore        Int      @default(100)
  behaviorProfile      String   @default("UNKNOWN") // 'RELIABLE', 'LATE', 'GHOST'
  averageDaysToPay     Int?
  overrideTone         String?  // e.g., "FRIENDLY"
  
  // Advanced Behavioral Intelligence
  behaviorType         String?  // 'SLOW_BUT_RELIABLE', 'REMINDER_TRIGGERED', 'CASHFLOW_CONSTRAINED', 'AVOIDANT', 'CORPORATE_DELAY', 'HIGH_RISK_GHOST'
  varianceInDays       Int?
  responseDelayAverage Int?
  toneSensitivity      String?
  paymentPattern       String?
  paymentReliability   Decimal? @db.Decimal(5, 2)
  engagementScore      Decimal? @db.Decimal(5, 2)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@unique([userId, email])
  @@index([userId])
}

// ─── Invoice ─────────────────────────────────────────────

model Invoice {
  id                 String           @id @default(cuid())
  userId             String           @db.Uuid
  clientId           String?
  clientName         String
  clientEmail        String
  amount             Decimal          @db.Decimal(12, 2)
  dueDate            DateTime
  description        String?
  status             InvoiceStatus    @default(UNPAID)
  state              InvoiceState     @default(DRAFT)
  stateMetadata      Json?            // Stores reasons for state changes, bounce errors, etc.
  lastStateChangeAt  DateTime         @default(now())
  
  // Financial Intelligence
  balance            Decimal          @default(0) @db.Decimal(12, 2)
  version            Int              @default(1)
  
  invoiceNumber      String?          // User-visible invoice number (e.g., INV-001)
  
  // Contact Configuration Snapshot
  whatsappNumber     String?          // Kept for data compatibility
  smsNumber          String?
  chasingProfile     ChasingProfile   @default(NORMAL)
  contactChannel     ContactChannel   @default(EMAIL)

  // AI & Smart Chasing
  reminderTone       ReminderTone     @default(PROFESSIONAL)
  chaseUntilPaid     Boolean          @default(false)
  chaseIntervalDays  Int              @default(7)  // Repeat every N days after stage 4

  // Reminder tracking
  reminderStage        Int              @default(0) // 0=none, 1=due, 2=stage1, 3=stage2, 4=stage3
  lastReminderSentAt   DateTime?
  lastChaseSentAt      DateTime?        // Last recurring chase reminder
  nextScheduledChaseAt DateTime?        // Exact computed time for next smart delivery
  idempotencyKeys      String[]         @default([])

  // File ingestion
  sourceFile         String?          // Original uploaded file path/reference
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  // Relations
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reminderLogs       ReminderLog[]
  paymentLink        PaymentLink?
  trackingEvents     InvoiceTracking[]
  invoiceEvents      InvoiceEvent[]
  aiMetadata         AIMetadata?

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([status, reminderStage, dueDate])
  @@index([invoiceNumber])
}

// ─── Reminder Log ────────────────────────────────────────

model ReminderLog {
  id              String   @id @default(cuid())
  invoiceId       String
  stage           Int
  status          String   // "sent", "failed", "skipped", "dead_letter"
  error           String?
  jobId           String?  // BullMQ job ID for traceability
  idempotencyKey  String?  // The key used for deduplication
  channel         String?  // "email", "sms", "system" — which channel was used
  tone            String?  // Which tone was used for message generation
  messageBody     String?  // Generated message content (for audit trail)
  persuasionStrategy String? // Behavioral trigger used (e.g. "Loss Aversion")
  sentAt          DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([sentAt])
  @@index([idempotencyKey])
}

// ─── Invoice Event (Lifecycle Audit Log) ─────────────────

model InvoiceEvent {
  id          String   @id @default(cuid())
  invoiceId   String
  eventType   String   // invoice_created, invoice_due_soon, invoice_overdue, payment_received, reminder_sent, email_opened, link_clicked
  metadata    Json?    // Flexible payload (stage, channel, risk score, etc.)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── User Credentials (Encrypted OAuth/API Tokens) ───────

model UserCredential {
  id            String    @id @default(cuid())
  userId        String    @db.Uuid
  provider      String    // "google_oauth", "twilio"
  accessToken   String    // Encrypted with AES-256-GCM
  refreshToken  String?   // Encrypted
  tokenExpiry   DateTime?
  metadata      Json?     // Provider-specific data (email for Google, phone for Twilio)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ─── Payment Link (One-Click Pay) ────────────────────────

model PaymentLink {
  id          String    @id @default(cuid())
  invoiceId   String    @unique
  token       String    @unique @default(cuid()) // Public URL-safe token
  isActive    Boolean   @default(true)
  clickCount  Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ─── Invoice Tracking (Open/Read/Click Events) ──────────

model InvoiceTracking {
  id          String   @id @default(cuid())
  invoiceId   String
  event       String   // "email_opened", "link_clicked", "payment_page_viewed"
  channel     String?  // "email", "sms"
  metadata    Json?    // IP, user-agent, timestamp context
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([event])
  @@index([createdAt])
}

// ─── AI Metadata (Risk Scoring + Extraction Data) ────────

model AIMetadata {
  id             String    @id @default(cuid())
  invoiceId      String    @unique
  riskScore      RiskLevel @default(MEDIUM)
  riskFactors    Json?     // Array of risk factor strings
  extractedData  Json?     // Raw AI-extracted fields from ingestion
  suggestedTone      ReminderTone? // AI-suggested tone based on context
  llmResponse        Json?     // Raw LLM response for audit
  persuasionStrategy String?   // E.g. "Loss Aversion Framing"
  recommendedAction  String?   // The next best action calculated by the engine
  createdAt          DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─── System Settings (For Admin AI Config) ─────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Transactional Outbox ────────────────────────────────

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String    // e.g., "invoice.created", "invoice.paid"
  payload     Json      // The event data payload
  processed   Boolean   @default(false)
  processedAt DateTime? // Set when claimed by outbox worker — retained for audit
  createdAt   DateTime  @default(now())

  @@index([processed, createdAt])
}

// ─── Data Moat (Anonymized Global Stats) ─────────────────

model BehavioralMetric {
  id          String   @id @default(cuid())
  metricKey   String   @unique
  metricValue Json
  updatedAt   DateTime @updatedAt
}
