# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_chaser?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/invoice_chaser?schema=public"

# Redis (required for BullMQ job queues)
# Local: redis://127.0.0.1:6379
# Production: use managed Redis (AWS ElastiCache, Redis Cloud, Upstash, etc.)
REDIS_URL="redis://127.0.0.1:6379"

# Supabase Auth
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Encryption — for securing OAuth tokens and API credentials in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── Email (SMTP Fallback) ────────────────────────────────
# Used when user hasn't connected their Google account
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Invoice Chaser <noreply@invoicechaser.com>"

# ─── Google OAuth (Send from User's Email) ────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Enable Gmail API at: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/settings/email/callback"

# ─── Twilio SMS (Mode B — System Fallback) ────────────────
# Used when user hasn't connected their own Twilio account
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Lemon Squeezy (Subscriptions) ───────────────────────
LEMON_SQUEEZY_API_KEY="your-lemonsqueezy-api-key"
LEMON_SQUEEZY_WEBHOOK_SECRET="CHANGE-ME-strong-webhook-secret"
LEMON_SQUEEZY_STORE_ID="12345"
LEMON_SQUEEZY_PRO_VARIANT_ID="67890"

# ─── AI / LLM ────────────────────────────────────────────
# Gemini API key for smart message generation
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging (optional) — debug, info, warn, error
LOG_LEVEL="info"
